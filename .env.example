# ARMS backend settings.
#
# Copy this file to .env and fill it in. Nothing here is written into the source
# — the handover documents say the databases live on `.\SQLEXPRESS`, the machine
# this was built on has them on the default instance under different names, and
# the FSA cloud server is a third arrangement nobody has specified yet. A value
# compiled into a source file would already be wrong three times over.

# ---- where the server listens -------------------------------------------------
PORT=3000
# 127.0.0.1 keeps it on this machine. Condemnation detail is commercially
# sensitive, so it does not bind to every interface until somebody decides that
# deliberately. Use 0.0.0.0 to expose it, behind a reverse proxy and TLS.
HOST=127.0.0.1
# Set when behind a proxy so printed links match what users actually type.
# PUBLIC_URL=https://arms.afsq.co.za

# ---- SQL Server ---------------------------------------------------------------
SQL_SERVER=localhost
# Default instance: set SQL_PORT, leave SQL_INSTANCE empty.
# Named instance (e.g. SQLEXPRESS): set SQL_INSTANCE, leave SQL_PORT empty —
# it is resolved by the SQL Browser service, which must be running.
SQL_PORT=1433
# SQL_INSTANCE=SQLEXPRESS

# `sql` uses a SQL Server login. `windows` needs the msnodesqlv8 native driver,
# which is Windows-only — if the FSA server turns out to be Linux (handover
# question 1) only `sql` will work.
SQL_AUTH=sql
SQL_USER=arms_reader
SQL_PASSWORD=

SQL_ENCRYPT=true
# true while the instance uses a self-signed certificate. Set false once a
# trusted certificate is installed — this is government-facing animal health data.
SQL_TRUST_CERT=true

# ---- the three databases ------------------------------------------------------
# Named separately because a site restores them under whatever names it uses.
# Every cross-database reference in the queries is built from these three.
DB_DATA=Schedule8Data
DB_REGISTRY=NAHDIS_FSA
DB_FORMS=Schedule8

# ---- ARMS rules ---------------------------------------------------------------
# ARMS starts at 2022 (Louis, 15 Aug 2026). Earlier returns are still in the
# database; they are excluded here, not deleted, because up to 86% of condemned
# organs in the early years were coded "Other" with no diagnosis.
ARMS_FROM_YEAR=2022
ARMS_FORM_ID=1

# Which abattoirs an inspector may file for: those still reporting inside this
# window, measured back from the most recent return in the database.
ABATTOIR_WINDOW_MONTHS=18

# How long a built payload is held before it is rebuilt from SQL. 0 disables
# caching, which is useful while debugging a query and slow otherwise.
CACHE_TTL_MS=900000

# ---- where the applications are ----------------------------------------------
# Default to the sibling handover folders, so a clean copy runs with none of
# these set. Override on a server, where the layout will be different.
# SYSTEM_DIR=../1 - The system
# BUILD_DIR=../2 - How it is built
# EXPLORER_TEMPLATE=../2 - How it is built/explorer-template.html
# EXPLORER_BUILT=../1 - The system/NAHDIS Explorer.html
# MOBILE_APP=../1 - The system/Schedule 8 Mobile.html
# DISEASE_MAP=../2 - How it is built/disease-name-map.csv

# The 2016 AFTER UPDATE trigger on FormData sends controlled-disease mail via
# sp_SendMail, and hardcodes NAHDIS_FSA..regions. If your registry database is
# NOT called exactly NAHDIS_FSA, that name binds to whatever else carries it —
# or the approval fails outright.
#   leave    keep it (correct when the databases have their original names)
#   disable  turn it off on this copy so approvals work. ARMS does not yet send
#            controlled-disease notifications, so nothing sends them. Known gap.
LEGACY_NOTIFY_TRIGGER=leave
