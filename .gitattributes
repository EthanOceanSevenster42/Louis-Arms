# Written on Windows, deployed on Linux. Normalise in the repository and check
# out per platform, so nobody sees a whole-file diff because of line endings.
* text=auto

# These are read by Linux tools that will not accept a carriage return.
# A Dockerfile or a systemd unit with CRLF fails in ways that read like a
# corrupt file: "no such file or directory" on a shebang that is plainly there.
*.sh            text eol=lf
*.conf          text eol=lf
*.service       text eol=lf
Dockerfile      text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf

# PowerShell stays CRLF - it is run on Windows, by Windows.
*.ps1           text eol=crlf

# The applications are served byte-for-byte and the phone app is strict ES5
# parsed on old devices. Leave them exactly as they are.
*.html          -text
*.csv           text eol=lf

# Never let a database backup in by accident, whatever the .gitignore says.
*.bak           binary
*.bacpac        binary
