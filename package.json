{
  "name": "arms-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Node backend for ARMS - serves the two applications in '1 - The system' over HTTP, with every value read live from the MySQL databases in '3 - The database'.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "check": "node src/check.js",
    "verify": "node src/verify-served.js",
    "init-db": "node src/init-db.js",
    "verify-auth": "node src/verify-auth.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "mysql2": "^3.11.5"
  }
}
